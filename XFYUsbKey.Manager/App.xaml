<Application x:Class="XFYUsbKey.Manager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Fluent Design 配色方案 -->
        <Color x:Key="AccentColor">#0078D4</Color>
        <Color x:Key="AccentLight">#E3F2FD</Color>
        <Color x:Key="BgDark">#1E1E1E</Color>
        <Color x:Key="BgCard">#F5F5F5</Color>
        <Color x:Key="BgSidebar">#FAFAFA</Color>
        <Color x:Key="TextPrimary">#1A1A1A</Color>
        <Color x:Key="TextSecondary">#666666</Color>

        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLight}" />
        <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCard}" />
        <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebar}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    </Application.Resources>
</Application>
