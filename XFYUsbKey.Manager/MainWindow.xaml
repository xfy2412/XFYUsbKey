<Window x:Class="XFYUsbKey.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XFY USB Key 管理器" Height="580" Width="860"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="14"
        Background="White"
        Icon="logo.png">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ========== 左侧导航栏 ========== -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}"
                BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,24,0,0">
                <!-- 标题 -->
                <TextBlock Text="XFY USB Key" FontSize="20" FontWeight="SemiBold"
                           Margin="20,0,20,24" Foreground="{StaticResource AccentBrush}" />

                <!-- 导航按钮 -->
                <RadioButton x:Name="NavHome" Content="  密钥管理" GroupName="Nav"
                             IsChecked="True" Margin="12,0" Height="40"
                             Checked="Nav_Checked" Cursor="Hand">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bg" Background="Transparent"
                                    CornerRadius="6" Padding="16,0">
                                <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Background"
                                            Value="{StaticResource AccentLightBrush}" />
                                    <Setter TargetName="Txt" Property="Foreground"
                                            Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True" SourceName="Bg">
                                    <Setter TargetName="Bg" Property="Background" Value="#EEEEEE" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>

                <RadioButton x:Name="NavSettings" Content="  设置" GroupName="Nav"
                             Margin="12,4" Height="40" Checked="Nav_Checked" Cursor="Hand">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bg" Background="Transparent"
                                    CornerRadius="6" Padding="16,0">
                                <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Background"
                                            Value="{StaticResource AccentLightBrush}" />
                                    <Setter TargetName="Txt" Property="Foreground"
                                            Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True" SourceName="Bg">
                                    <Setter TargetName="Bg" Property="Background" Value="#EEEEEE" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>

                <RadioButton x:Name="NavAbout" Content="  关于" GroupName="Nav"
                             Margin="12,4" Height="40" Checked="Nav_Checked" Cursor="Hand">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bg" Background="Transparent"
                                    CornerRadius="6" Padding="16,0">
                                <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Background"
                                            Value="{StaticResource AccentLightBrush}" />
                                    <Setter TargetName="Txt" Property="Foreground"
                                            Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True" SourceName="Bg">
                                    <Setter TargetName="Bg" Property="Background" Value="#EEEEEE" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- ========== 右侧内容区 ========== -->
        <ScrollViewer Grid.Column="1">
            <Grid Margin="32,24">

                <!-- ===== 首页：密钥管理 ===== -->
                <StackPanel x:Name="PageHome" Visibility="Visible">
                    <TextBlock Text="XFY USB Key" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="用 USB 密钥保护你的 Windows 登录" FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,24" />

                    <!-- USB 密钥状态卡片 -->
                    <Border Background="{StaticResource BgCardBrush}"
                            CornerRadius="8" Padding="24" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="USB 密钥状态" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="StatusText" Text="未检测到 USB 密钥"
                                       FontSize="14" Margin="0,12,0,0" Foreground="#CC5555" />

                            <!-- 盘符选择 -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="目标 U 盘：" VerticalAlignment="Center" Grid.Column="0" />
                                <ComboBox x:Name="DriveSelector" Grid.Column="1" MinWidth="200"
                                          Margin="12,0,0,0" DisplayMemberPath="Display" />
                            </Grid>

                            <!-- 密码输入 -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="登录密码：" VerticalAlignment="Center" Grid.Column="0" />
                                <PasswordBox x:Name="PasswordBox" Grid.Column="1"
                                             Margin="12,0,0,0" MinWidth="200" />
                            </Grid>

                            <!-- PIN 码 -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PIN 码（可选）：" VerticalAlignment="Center" Grid.Column="0" />
                                <PasswordBox x:Name="PinBox" Grid.Column="1"
                                             Margin="12,0,0,0" MinWidth="200" />
                            </Grid>

                            <Button Content="写入 U 盘密钥" Margin="0,16,0,0"
                                    Padding="16,8" HorizontalAlignment="Left"
                                    Background="{StaticResource AccentBrush}" Foreground="White"
                                    BorderThickness="0" FontSize="14"
                                    Click="BtnWriteKey_Click" />
                        </StackPanel>
                    </Border>

                    <!-- 使用说明卡片 -->
                    <Border Background="{StaticResource BgCardBrush}"
                            CornerRadius="8" Padding="24">
                        <StackPanel>
                            <TextBlock Text="使用说明" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="1. 插入 U 盘，点击「初始化 U 盘为登录密钥」" Margin="0,8,0,0" />
                            <TextBlock Text="2. 输入你的 Windows 登录密码" Margin="0,4,0,0" />
                            <TextBlock Text="3. 密钥文件将加密存储在 U 盘的 \.xfykey\ 目录下" Margin="0,4,0,0" />
                            <TextBlock Text="4. 锁屏后插入 U 盘即可自动登录" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== 设置页 ===== -->
                <StackPanel x:Name="PageSettings" Visibility="Collapsed">
                    <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="自定义 USB 密钥的行为" FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,24" />

                    <Border Background="{StaticResource BgCardBrush}"
                            CornerRadius="8" Padding="24" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="PIN 码保护" FontSize="18" FontWeight="SemiBold" />
                            <CheckBox x:Name="ChkPinProtect" Content="启用 PIN 码保护（双因素认证）" Margin="0,12,0,0" />
                            <TextBlock Text="启用后，插入 U 盘后仍需输入 PIN 码才能登录" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="24,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource BgCardBrush}"
                            CornerRadius="8" Padding="24">
                        <StackPanel>
                            <TextBlock Text="拔出 U 盘时" FontSize="18" FontWeight="SemiBold" />
                            <RadioButton x:Name="RdoLock" Content="锁定电脑" IsChecked="True" Margin="0,12,0,0" />
                            <RadioButton x:Name="RdoLogoff" Content="注销" Margin="0,8,0,0" />
                            <RadioButton x:Name="RdoShutdown" Content="关机" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== 关于页 ===== -->
                <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                    <TextBlock Text="关于" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />
                    <Border Background="{StaticResource BgCardBrush}"
                            CornerRadius="8" Padding="24">
                        <StackPanel>
                            <TextBlock Text="XFY USB Key" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="版本 1.0" Margin="0,8,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="一款将 USB 变为 Windows 登录密钥的安全工具" Margin="0,4,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="基于 DPAPI 加密，绑定 U 盘序列号，保护你的系统安全" Margin="0,4,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
